# Andika — M-PESA (Safaricom Daraja) configuration
# Copy this file to server/.env and fill in your values.
# Get sandbox credentials at https://developer.safaricom.co.ke → your app →
# Keys, and use the Lipa na M-PESA Sandbox test credentials for the passkey.

# "sandbox" while testing, "live" for real production payments.
DARAJA_ENV=sandbox

# From your Daraja app (Consumer Key / Consumer Secret).
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=

# Paybill / Till shortcode that receives the money.
# Sandbox default test paybill is 174379.
DARAJA_SHORTCODE=174379

# Lipa na M-PESA Online (STK Push) passkey.
DARAJA_PASSKEY=

# Public HTTPS URL Daraja will call with the payment result.
# Must be reachable from the internet (use a tunnel such as ngrok or
# cloudflared during local development), e.g.
# https://your-domain.ngrok-free.app/api/callback
DARAJA_CALLBACK_URL=

# Port the Andika server listens on.
PORT=8000
